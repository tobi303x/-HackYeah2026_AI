                        "category_slug": "dla-seniorow",
                        "authors": "- Maria Lorenc - Maciej Parol",
                        "source_url": "https://rops.krakow.pl/innowacje-spoleczne/biblioteka-innowacji-spolecznych/dla-seniorow,bawita",
                        "file_zip": "https://rops.krakow.pl/pliki/IS/bibloteka/bawita.zip",
                        "youtube_video": "https://www.youtube.com/watch?v=o7UhDlebLJo"
                      }
                    ]
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      },
