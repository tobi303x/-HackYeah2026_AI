  "components": {
    "securitySchemes": {
      "ApiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key",
        "description": "Authorization key. Can be supplied in header `X-API-Key`, `Authorization: Bearer <key>`, or inside JSON body as `\"api_key\": \"...\"`"
      },
      "AdminApiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Admin-API-Key",
        "description": "Administrative key required for creating and deleting collections. Can also be supplied in JSON body as admin_api_key or query param ?admin_api_key="
      }
    },
    "schemas": {
      "ROPSMetadata": {
        "type": "object",
        "description": "Metadata attributes for a ROPS Social Innovation",
        "properties": {
          "title": {
            "type": "string",
            "example": "BaWita",
            "description": "Innovation title"
          },
          "category_id": {
            "type": "integer",
            "example": 1,
            "description": "Category numeric ID (1-9)"
          },
          "category_name": {
            "type": "string",
            "example": "Innowacje dla seniorów",
            "description": "Human-readable category name"
          },
          "category_slug": {
            "type": "string",
            "example": "dla-seniorow",
            "description": "URL slug for category"
          },
          "authors": {
            "type": "string",
            "example": "- Maria Lorenc - Maciej Parol",
            "description": "Authors / innovators"
          },
          "source_url": {
            "type": "string",
