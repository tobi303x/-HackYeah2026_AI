    "/api/documents": {
      "get": {
        "tags": [
          "Documents"
        ],
        "summary": "Retrieve documents from collection",
        "description": "Fetches documents from `rops_innovations` by ID or with pagination.",
        "parameters": [
          {
            "name": "collection_name",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "rops_innovations"
            },
            "description": "Collection name (defaults to rops_innovations)"
          },
          {
            "name": "ids",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "example": "dla-seniorow__bawita,dla-seniorow__therapy-set"
            },
            "description": "Comma-separated IDs"
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 10
            },
            "description": "Max records to return"
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 0
            },
            "description": "Offset for pagination"
          },
          {
            "name": "api_key",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "API Key"
          }
        ],
        "responses": {
          "200": {
            "description": "Retrieved documents",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetDocumentsResponse"
                },
                "example": {
                  "status": "success",
                  "collection": "rops_innovations",
                  "total": 115,
                  "limit": 1,
                  "offset": 0,
                  "data": {
                    "ids": [
                      "dla-seniorow__bawita"
                    ],
                    "documents": [
                      "Tytuł innowacji: BaWita\n\nKategoria: Innowacje dla seniorów\n\nRozwiązanie: Narzędzie rehabilitacyjne w postaci drewnianej tablicy..."
